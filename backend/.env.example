# Copier en .env (jamais commité). Configuration par variables d'environnement uniquement.
# development : CORS ouvert à toute extension chrome-extension:// et débogage permis. Toute autre valeur = production.
AMIRA_ENV=development
# Production : identifiant de l'extension publiée, obligatoire (chrome-extension://<id>, séparés par des virgules)
AMIRA_ALLOWED_ORIGINS=
AMIRA_ENGINE_VERSION=amira-nllb-ff-stage2
# Annoncé dans /v1/capabilities
AMIRA_TTS_ENABLED=true
AMIRA_STT_ENABLED=false
AMIRA_LANGUAGES=fr,en,ff
AMIRA_VARIETIES=ngaoundere,garoua,maroua
