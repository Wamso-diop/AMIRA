# Copier en .env (jamais commité). Configuration par variables d'environnement uniquement.
# development : CORS ouvert à toute extension chrome-extension:// et débogage permis. Toute autre valeur = production.
AMIRA_ENV=development
# Production : identifiant de l'extension publiée, obligatoire (chrome-extension://<id>, séparés par des virgules)
AMIRA_ALLOWED_ORIGINS=
AMIRA_ENGINE_VERSION=amira-nllb-ff-stage2
# Annoncé dans /v1/capabilities
AMIRA_TTS_ENABLED=true
AMIRA_STT_ENABLED=false
AMIRA_LANGUAGES=fr,en,ff
AMIRA_VARIETIES=ngaoundere,garoua,maroua
# Sens autorisés (jamais fr↔en)
AMIRA_DIRECTIONS=fr>ff,en>ff,ff>fr,ff>en
AMIRA_DB_PATH=data/amira.sqlite3
# Moteur : nllb (modèle local, chargé en tâche de fond) ou memory (mémoire validée seule)
AMIRA_ENGINE=nllb
AMIRA_MODEL_DIR=models/nllb_ff
AMIRA_LANG_CODES=fr=fra_Latn,en=eng_Latn,ff=fuv_Latn
# Seuils de confiance (à calibrer sur le fichier relu par le natif)
AMIRA_MIN_CONFIDENCE=0.5
AMIRA_MIN_CONFIDENCE_FROM_FF=0.7
# Budget du moteur par requête (le front coupe à 8 s), taille des paquets, durée estimée par segment (docs/PERF.md)
AMIRA_ENGINE_BUDGET_S=6
AMIRA_ENGINE_BATCH=4
AMIRA_ENGINE_SEG_S=0.8
