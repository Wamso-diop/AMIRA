{
  "name": "amira-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc --noEmit && vite build && vite build --config vite.content.config.ts && node scripts/build-manifest.mjs",
    "build:harness": "vite build --config vite.harness.config.ts",
    "jury": "node scripts/build-jury.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test": "vitest run",
    "test:e2e": "npm run build:harness && playwright test",
    "safinum": "npm run build && node scripts/safinum-run.mjs",
    "screens": "node scripts/screens.mjs",
    "apercu": "vite --open /apercu.html"
  },
  "dependencies": {
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/chrome": "^0.3.7",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
